# Revora Backend — Environment Variables
# Copy this file to .env and fill in your values.
# For Railway deployment, set these as environment variables in the Railway dashboard.

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
DEMO_MODE=true                   # true = no external API calls needed

# ─── Database ─────────────────────────────────────────────────────────────────
# Local development (SQLite — no setup needed):
DATABASE_URL=sqlite:///./revora.db

# Railway PostgreSQL (set this in Railway dashboard → Variables):
# DATABASE_URL=postgresql://user:password@host:port/dbname
# Railway auto-injects DATABASE_URL when you add a PostgreSQL plugin.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
FRONTEND_URL=http://localhost:5173
# On Railway, set FRONTEND_URL to your deployed frontend URL:
# FRONTEND_URL=https://your-frontend.up.railway.app

# ─── Razorpay (Test Mode) ─────────────────────────────────────────────────────
# Get test keys from: https://dashboard.razorpay.com → Settings → API Keys
# In DEMO_MODE=true these are not required.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ─── AI Provider (Anthropic) ──────────────────────────────────────────────────
# Get your API key from: https://console.anthropic.com → API Keys
# In DEMO_MODE=true this is not required.
AI_API_KEY=sk-ant-xxxxxxxxxxxx
AI_MODEL=claude-opus-5

# ─── Voice Provider ───────────────────────────────────────────────────────────
VOICE_PROVIDER=demo              # demo | production
VOICE_API_KEY=

# ─── Email Provider ───────────────────────────────────────────────────────────
EMAIL_PROVIDER=demo              # demo | production
EMAIL_API_KEY=

# ─── Recovery Policy (optional overrides) ─────────────────────────────────────
# QUIET_HOURS_START=22
# QUIET_HOURS_END=8
# MAX_RETRY_ATTEMPTS=3
# MAX_AUTOMATED_AMOUNT=10000
# MIN_AI_CONFIDENCE=0.70
# RECOVERY_WINDOW_HOURS=72
# MAX_CONTACTS_PER_WINDOW=3
